# Set values in your shell or copy this example yourself. No secrets are provided.
# MUST fill JWT_SECRET and both SEED_ADMIN values before first authenticated use.
# Runtime mode; development permits an ephemeral JWT secret if absent.
APP_ENV=development
# Postgres + pgvector from docker-compose.yml (host port 5433). SQLite (sqlite:///./data/app.db) still works
# for local experiments and the test suite, but vector search and full-text search need Postgres.
DATABASE_URL=postgresql+psycopg://rca:rca@localhost:5433/rca
# Where uploaded machine documents are stored (default data/documents).
DOCUMENTS_DIR=
# MUST fill: generate at least 32 random characters; never commit the result.
JWT_SECRET=
# Session lifetime in minutes.
JWT_EXPIRE_MINUTES=60
# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MUST fill together: initial admin account. Idempotent seed does not reset passwords.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional demo users: demo-admin@demo.local (admin), engineer@demo.local, qa@demo.local, viewer@demo.local.
# When true AND APP_ENV=development, the login page's demo buttons fill email and password (the password is
# served by GET /api/public/config). Never enable on a shared or production server.
DEMO_USERS_ENABLED=false
# MUST fill when demo users enabled: 10–72 UTF-8 bytes, same policy as admin.
DEMO_PASSWORD=
# Incident CSV and separate machine document byte limits in MiB.
UPLOAD_MAX_MB=10
DOC_UPLOAD_MAX_MB=20
# Optional wording; missing keys always use templates.
LLM_ENABLED=true
# groq | gemini | openai_compatible | anthropic | fake (fake is only a test provider).
# gemini = openai_compatible with Google's base URL as default. Key from https://aistudio.google.com/apikey
# Gemini example (either form works):
#   LLM_PROVIDER=gemini                 (LLM_BASE_URL may stay empty)
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.8-flash
#   LLM_API_KEY=<your Gemini key>
# HTTP 429 / RESOURCE_EXHAUSTED / Retry-After > 60 s is never retried: templates are used at once and live
# calls are blocked until the provider's retry time. HTTP 503 is retried at most twice (1 s, 2 s).
LLM_PROVIDER=groq
# Choose a model supported by your configured endpoint.
LLM_MODEL=llama-3.3-70b-versatile
# MUST fill to use an LLM: the key for LLM_PROVIDER (Gemini: https://aistudio.google.com/apikey).
LLM_API_KEY=
# Legacy Groq key alias, read ONLY when LLM_PROVIDER=groq and LLM_API_KEY is empty.
GROQ_API_KEY=
# API root ending in /v1. Required for openai_compatible; defaults chosen for groq/anthropic.
LLM_BASE_URL=
# HTTP timeout per call and retries on invalid output / timeouts (never on 4xx or quota errors).
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
# Provider requests allowed per UTC day (counted in the database; Gemini free tier is about 20/day).
LLM_DAILY_BUDGET=18
# Provider requests allowed per analysis (one agent plan + one wording call).
LLM_MAX_CALLS_PER_ANALYSIS=2
# false or no key selects deterministic read-only investigation.
AGENT_ENABLED=true
# deterministic (default, no LLM calls) | llm_plan (ONE LLM call returns the whole read-only tool plan).
AGENT_MODE=deterministic
# Maximum read-only tool calls per investigation (1–30).
AGENT_MAX_STEPS=10
# fastembed (local, default) | none | openai_compatible. Lexical search always runs.
# Embeddings are stored as pgvector vector(384); the model must produce 384 dimensions.
EMBEDDINGS_PROVIDER=fastembed
# Local fastembed model (384 dimensions). Downloaded once into data/embedding_cache.
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
# Required only for openai_compatible embeddings; obtain from that provider.
EMBEDDINGS_API_KEY=
# Required only for openai_compatible embeddings; API root ending in /v1.
EMBEDDINGS_BASE_URL=
# Retrieval chunk limit per hypothesis and minimum raw relevance (> threshold).
RAG_TOP_K=4
RAG_MIN_SCORE=0
# Optional separate live rubric judge (uses LLM_API_KEY); skipped without a key.
JUDGE_ENABLED=false
JUDGE_MODEL=llama-3.3-70b-versatile
# Tests only: pytest --db postgres (or TEST_DB=postgres) uses this server; a separate rca_test database
# is created automatically and each test gets a throwaway schema. Evaluation workers follow EVAL_DB.
TEST_DB=sqlite
TEST_POSTGRES_URL=postgresql+psycopg://rca:rca@localhost:5433/rca_test
